# Copy to .env.local and fill in. Names only: real values live in the hosting settings (Netlify) and .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Order emails (leave out to skip them): the sending Gmail address, its app password, and where the owner's alert goes
SMTP_USER=
SMTP_APP_PASSWORD=
ORDER_NOTIFY_EMAIL=
# Shiprocket (needed for "Send to Shiprocket" in the admin)
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# Online payments through Cashfree (server-only; Cashfree > Developers > API keys). CASHFREE_ENV=production for real payments.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox
# Supabase secret key (Project Settings > API keys > Secret keys), server-only: lets the server mark orders paid
SUPABASE_SECRET_KEY=
# Later, server-only (never expose to the browser):
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
